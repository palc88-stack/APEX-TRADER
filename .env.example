# ======================================
# APEX TRADER - Environment Variables
# ======================================
# انسخ هذا الملف إلى .env وأضف قيمك

# === Binance API ===
BINANCE_API_KEY=your_binance_api_key_here
BINANCE_SECRET_KEY=your_binance_secret_here
BINANCE_TESTNET=true
ALLOW_LIVE_TRADING=false
TRADING_EXECUTION_ENABLED=false
ALLOW_NEW_ENTRIES=false
PRIMARY_EXCHANGE=binance

# === Bybit API ===
BYBIT_API_KEY=your_bybit_api_key_here
BYBIT_SECRET_KEY=your_bybit_secret_here
BYBIT_TESTNET=true

# === Supabase ===
SUPABASE_URL=your_supabase_url
SUPABASE_WRITE_KEY=your_backend_write_key
VITE_SUPABASE_URL=your_supabase_url
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key


# === Upstash Redis ===
UPSTASH_REDIS_URL=your_upstash_redis_url_here
UPSTASH_REDIS_TOKEN=your_upstash_token_here

# === Telegram ===
TELEGRAM_BOT_TOKEN=your_telegram_bot_token
TELEGRAM_CHAT_ID=your_telegram_chat_id

# === Bot Settings ===
INITIAL_BALANCE=100
MAX_DAILY_LOSS_PCT=4.0
MAX_RISK_PER_TRADE_PCT=2.0
MAX_LEVERAGE=20
MAX_POSITION_PCT=5.0
MIN_CONFIDENCE=0.65
MAX_RSI_BUY=42.0
MIN_RSI_SELL=58.0
MIN_VOLUME_RATIO=0.5
ACTIVE_MODE=HUNTER
COMPOUNDING_RATE=0.70
ENVIRONMENT=testnet

# === Dynamic high-liquidity universe ===
UNIVERSE_SIZE=20
UNIVERSE_REFRESH_HOURS=4
UNIVERSE_QUOTE=USDT
MAX_OPEN_POSITIONS=3
MAX_NEW_ENTRIES_PER_CYCLE=1
UNIVERSE_REFRESH_ONLY=false
